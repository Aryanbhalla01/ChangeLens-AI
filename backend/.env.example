# Restrict repository access to one or more explicitly approved local directories.
# Separate multiple paths with the platform path separator (semicolon on Windows).
CHANGELENS_ALLOWED_REPO_ROOTS=C:\Users\YourName\source

# Writable server-managed storage for connected public GitHub repositories.
# Use a persistent volume outside CHANGELENS_ALLOWED_REPO_ROOTS in deployments.
CHANGELENS_MANAGED_REPO_ROOT=C:\ChangeLens\data\repositories
CHANGELENS_MAX_PUBLIC_REPOSITORY_SIZE_MB=100
CHANGELENS_PUBLIC_REPOSITORY_CLONE_TIMEOUT_SECONDS=120

# Comma-separated browser origins allowed to call the local API.
CHANGELENS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional. Defaults to backend/app/instance/changelens.sqlite3.
# CHANGELENS_DATABASE_URL=sqlite:///C:/Users/YourName/changelens.sqlite3

# Replace for deployments beyond a local development machine.
CHANGELENS_SECRET_KEY=replace-this-local-development-value
